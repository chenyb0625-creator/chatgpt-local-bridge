{
  "manifest_version": 3,
  "name": "AI Local Project Bridge",
  "version": "1.1.0",
  "description": "Browse local project files and insert them (with a project structure tree) into ChatGPT / DeepSeek input boxes.",
  "permissions": [],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.deepseek.com/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "action": {
    "default_title": "AI Local Project Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
